# ===========================================
# ClawChat Environment Configuration
# ===========================================
# Copy this file to .env and update the values
#   cp .env.example .env

# --- Server ---
# Set 0.0.0.0 only when this server should accept connections from the LAN.
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- Database ---
DATABASE_URL=sqlite:///./data/clawchat.db

# --- Authentication ---
# JWT_SECRET is auto-generated each session if left as the default and no
# JWT_SECRET_FILE is configured. The desktop app supplies a protected secret
# file automatically; manual deployments should set one of these explicitly.
JWT_SECRET=change-this-to-a-random-secret-key
# JWT_SECRET_FILE=/var/lib/clawchat/server-jwt-secret

# Six-digit PIN used to log in
PIN=123456

# JWT token expiration in hours
JWT_EXPIRY_HOURS=24

# --- Brute-force protection ---
# Failed PIN logins and failed pairing claims are throttled per caller.
# A successful login clears that caller's counter.
RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=60
PAIRING_MAX_FAILURES=5
PAIRING_FAILURE_WINDOW_SECONDS=300
PAIRING_LOCKOUT_SECONDS=60

# Honour X-Forwarded-For for throttling. Enable ONLY behind a reverse proxy you
# control -- a directly reachable server lets clients spoof the header.
TRUST_PROXY_HEADERS=false

# --- CORS ---
# Comma-separated origins allowed to call this API from a browser.
# Empty (default) allows local dev origins plus PUBLIC_URL.
# "*" allows any site to call this server -- development only.
CORS_ALLOW_ORIGINS=

# --- AI Provider ---
# Options: "ollama", "openai", "claude_code", "codex_cli", or "codex"
# "ollama" and "openai" use the OpenAI-compatible Chat Completions adapter.
AI_PROVIDER=ollama

# When the provider above is unreachable at startup, activate any other
# provider that is ready (Claude Code CLI, Codex CLI, the relay, then the Codex
# API) instead of failing every chat. Set false to pin this deployment to the
# configured backend and surface the error instead.
AI_PROVIDER_FALLBACK=true

# Remembers the provider picked in the app's settings screen so a restart keeps
# it, taking precedence over AI_PROVIDER above. The desktop app sets this
# itself; leave empty to keep AI_PROVIDER authoritative.
# AI_PROVIDER_FILE=/var/lib/clawchat/active-ai-provider

# Ollama local:             http://localhost:11434
# Ollama via Docker Compose: http://ollama:11434
# OpenAI:                   https://api.openai.com
AI_BASE_URL=http://localhost:11434

# Optional bearer token for the OpenAI-compatible gateway; leave empty for Ollama
AI_API_KEY=

# Model name (e.g. llama3.2, gpt-4o, claude-3-opus, etc.)
AI_MODEL=llama3.2

# --- Codex API (optional) ---
# Codex uses OpenAI's Responses API and has separate settings so it can be
# switched at runtime without replacing the OpenClaw/Ollama configuration.
CODEX_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY is also accepted when CODEX_API_KEY is empty.
CODEX_API_KEY=
# Optional owner-only credential file. The desktop app configures this itself.
CODEX_API_KEY_FILE=
CODEX_MODEL=gpt-5.3-codex
CODEX_REASONING_EFFORT=medium

# --- Codex CLI (optional) ---
# Uses the locally installed CLI and existing `codex login`. Empty model uses
# the selection from ~/.codex/config.toml. CLI sessions run read-only and are
# not persisted by ClawChat.
# Defaults to the cheaper Luna tier; raise it (e.g. gpt-5.6-sol) if you need
# more capability and accept the higher per-run cost.
CODEX_CLI_MODEL=gpt-5.6-luna

# --- Claude Code CLI (optional) ---
# Model alias passed to `claude --model`. Empty uses whatever the CLI itself
# defaults to. "sonnet" keeps ClawChat's calls off the pricier flagship tier.
CLAUDE_CODE_MODEL=sonnet

# --- Paseo execution provider (optional) ---
# Requires the official `paseo` CLI on the ClawChat server host. Authentication
# and relay pairing remain owned by Paseo. Project repository paths are set in
# each Project workspace after enabling the adapter.
PASEO_ENABLED=false
PASEO_CLI_COMMAND=paseo
# Local daemon: leave empty. Remote examples: workstation.local:6767 or an
# E2EE Paseo offer URL. Offer URLs are passed through PASEO_HOST, not argv.
PASEO_HOST=
PASEO_DEFAULT_PROVIDER=codex
PASEO_POLL_INTERVAL_SECONDS=3
PASEO_COMMAND_TIMEOUT_SECONDS=30
PASEO_RECONNECT_GRACE_SECONDS=120

# --- File Uploads ---
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=10

# --- Public URL ---
# If ClawChat is behind a reverse proxy (Cloudflare Tunnel, Caddy, Nginx, etc.),
# set this to the public-facing URL so pairing QR codes and API responses use
# the correct address instead of the local host/port.
# PUBLIC_URL=https://clawchat.example.com

# --- Frontend Default Server URL ---
# Baked into the frontend at build time. When set, the login page uses this as
# the default server URL instead of window.location.origin.
# Useful for Cloudflare Tunnel or any fixed reverse proxy hostname.
# VITE_DEFAULT_SERVER_URL=https://clawchat.example.com

# --- Obsidian ---
# Absolute path to your Obsidian vault (for one-way task export)
OBSIDIAN_VAULT_PATH=

# --- Scheduler ---
ENABLE_SCHEDULER=true
BRIEFING_TIME=08:00
REMINDER_CHECK_INTERVAL=60
