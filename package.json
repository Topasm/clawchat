{
  "name": "clawchat",
  "version": "1.4.8",
  "private": true,
  "description": "ClawChat — Privacy-first, self-hosted agentic todo app",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "dev:full": "concurrently --names web,api --prefix-colors cyan,yellow \"npm run dev\" \"uv run --project server --locked uvicorn main:app --app-dir server --reload --host 0.0.0.0 --port 8000\"",
    "build": "npm run build:web",
    "build:web": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:tauri-renderer": "cross-env TAURI_ENV_PLATFORM=linux npm run build:web",
    "build:tauri": "tauri build --no-bundle",
    "build:tauri-server": "uv run --project server --locked --no-dev --group build python scripts/build-tauri-server-bundle.py && npm run check:tauri-server",
    "check:tauri-server": "node scripts/check-tauri-server-bundle.js",
    "check:tauri-package": "node scripts/verify-tauri-package.js",
    "check:tauri-artifact-budget": "node scripts/check-tauri-artifact-budget.js",
    "check:actions-pinned": "node scripts/check-github-actions-pinning.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:licenses": "node scripts/check-dependency-licenses.js",
    "check:runtime-boundary": "node scripts/check-runtime-boundary.js",
    "check:design-tokens": "node scripts/check-design-tokens.js",
    "check:ui-i18n": "node scripts/check-ui-localization.mjs",
    "check:i18n-catalog": "node scripts/generate-korean-catalog.js --check",
    "check:icon-design": "node scripts/check-icon-design.js",
    "check:release-version": "node scripts/check-release-version.js",
    "check:api-contract": "node scripts/generate-api-contracts.js --check",
    "check:schema-drift": "node scripts/check-schema-contract-drift.js",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "lint:prune": "eslint src --prune-suppressions",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "node scripts/check-prettier-baseline.mjs",
    "format:baseline": "node scripts/check-prettier-baseline.mjs --write-baseline",
    "format:check:all": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:ui-i18n && npm run check:i18n-catalog && npm run check:design-tokens && npm run check:icon-design && npm run check:licenses && npm run check:runtime-boundary && npm run check:api-contract && npm run check:schema-drift && npm run format:rust:check",
    "pre-commit": "npm run check && npm test",
    "measure:renderer": "node scripts/measure-renderer-bundle.js dist",
    "check:renderer-budget": "node scripts/check-renderer-performance-budget.js dist",
    "prepare:tauri-release": "node scripts/create-tauri-release-config.js",
    "generate:tauri-release": "node scripts/generate-tauri-release.js",
    "generate:icons": "node scripts/generate-brand-icons.js",
    "package:tauri": "npm run check:tauri-server && tauri build --config src-tauri/tauri.bundle.conf.json",
    "package:tauri:release": "npm run check:tauri-server && npm run prepare:tauri-release && tauri build --config src-tauri/tauri.release.generated.conf.json",
    "preview": "vite preview",
    "test": "vitest run && npm run test:scripts",
    "test:scripts": "node --test scripts/android-build-workflow.test.js scripts/android-release-workflow.test.js scripts/check-release-version.test.js scripts/create-tauri-release-config.test.js scripts/dependency-license-policy.test.js scripts/docker-publish-workflow.test.js scripts/design-tokens.test.js scripts/generate-api-contracts.test.js scripts/schema-contract-drift.test.js scripts/generate-tauri-release.test.js scripts/github-actions-pinning.test.js scripts/icon-design.test.js scripts/prettier-baseline.test.js scripts/renderer-performance-budget.test.js scripts/runtime-boundary.test.js scripts/server-bundle-manifest.test.js scripts/startup-theme.test.js scripts/tauri-artifact-budget.test.js scripts/tauri-preview-workflow.test.js scripts/tauri-release-workflow.test.js",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "check:rust": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check:rust:container": "bash scripts/tauri-linux-container.sh",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:rust-core": "cargo test --locked --manifest-path src-tauri/Cargo.toml -p clawchat-core-tests",
    "test:tauri-migration-audit": "python -B -m unittest scripts.tests.test_verify_tauri_data_import",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "dist:android": "cd android && chmod +x ./gradlew && ./gradlew assembleDebug",
    "dist:android:prod": "cd android && chmod +x ./gradlew && ./gradlew assembleRelease",
    "install:android": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "generate:openapi": "uv run --project server --locked python scripts/export-openapi.py",
    "generate:contracts": "node scripts/generate-api-contracts.js",
    "generate:api": "npm run generate:openapi && npm run generate:contracts",
    "generate:i18n-catalog": "node scripts/generate-korean-catalog.js"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2.11.1",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.5",
    "axios": "^1.20.0",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^13.1.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "25.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
