{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimal native permissions for the ClawChat main window",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-server-get-status",
    "allow-server-get-config",
    "allow-server-issue-local-session",
    "allow-server-get-network-info",
    "allow-server-update-config",
    "allow-server-select-folder",
    "allow-server-open-obsidian-vault",
    "allow-server-open-log-folder",
    "allow-server-open-data-folder",
    "allow-server-set-app-mode",
    "allow-server-get-app-mode",
    "allow-app-show-notification",
    "allow-app-set-badge-count",
    "allow-app-open-camera-settings",
    "allow-app-open-canonical-document",
    "allow-app-set-workspace-view-mode",
    "allow-secure-storage-get",
    "allow-secure-storage-set",
    "allow-secure-storage-remove",
    "allow-updater-check",
    "allow-updater-download",
    "allow-updater-install",
    "allow-worker-run"
  ]
}
