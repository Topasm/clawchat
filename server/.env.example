# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/clawchat.db

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_HOURS=24
PIN=replace-with-a-strong-random-pin

# Optional: outbound E2EE relay for mobile access outside the LAN
# RELAY_URL=https://relay.example.com

# AI — delegates to an OpenAI-compatible gateway, local CLI, or Codex API
# AI_PROVIDER: "ollama" (default), "openai", "claude_code", "codex_cli", or "codex"
# AI_PROVIDER_FALLBACK=true activates any ready provider when that one is down.
# AI_PROVIDER_FILE persists the provider picked in the app across restarts.
# Set AI_PROVIDER=claude_code to use the locally installed Claude Code CLI
# Set AI_PROVIDER=codex_cli to reuse a local `codex login`
# Set AI_PROVIDER=codex to start with the OpenAI Codex Responses API
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:18789
AI_API_KEY=your-openclaw-gateway-token
AI_MODEL=openclaw

# Codex API (kept separate from the OpenAI-compatible gateway above)
CODEX_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY is accepted as a fallback.
CODEX_API_KEY=
# CODEX_API_KEY_FILE=/var/lib/clawchat/codex-api-key
CODEX_MODEL=gpt-5.3-codex
CODEX_REASONING_EFFORT=medium
# Empty uses the model selected in ~/.codex/config.toml.
CODEX_CLI_MODEL=gpt-5.6-luna

# Model alias passed to `claude --model`. Empty uses the CLI's own default.
CLAUDE_CODE_MODEL=sonnet

# Optional Paseo daemon execution backend
PASEO_ENABLED=false
PASEO_CLI_COMMAND=paseo
PASEO_HOST=
PASEO_DEFAULT_PROVIDER=codex
PASEO_POLL_INTERVAL_SECONDS=3
PASEO_COMMAND_TIMEOUT_SECONDS=30
PASEO_RECONNECT_GRACE_SECONDS=120

# Obsidian (opt-in vault scanning; export-only by default)
# OBSIDIAN_VAULT_PATH=
# OBSIDIAN_WATCH_ENABLED=false
# OBSIDIAN_SCAN_INTERVAL_MINUTES=5  # Used only if event watching is unavailable
