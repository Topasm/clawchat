<?xml version="1.0" encoding="utf-8"?>
<!--
  The session DataStore holds the device token that authenticates this device,
  the Room cache holds task content, and share-outbox may contain private files
  pinned to that session. None belongs in backup or device transfer: a restored
  copy would carry data the user never re-authorized on the new installation.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="share-outbox" />
        <exclude domain="database" path="clawchat_cache" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="share-outbox" />
        <exclude domain="database" path="clawchat_cache" />
    </device-transfer>
</data-extraction-rules>
